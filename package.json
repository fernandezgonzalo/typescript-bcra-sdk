{
  "name": "bcra-sdk",
  "version": "0.1.0",
  "description": "SDK oficial para la API del Banco Central de la República Argentina",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "docs": "typedoc",
    "record:fixtures": "node scripts/record_fixtures.mjs",
    "release": "changeset publish",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "bcra",
    "banco-central",
    "argentina",
    "sdk",
    "api",
    "finance"
  ],
  "author": "gonzadev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gonzadev/typescript-bcra-sdk.git"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typedoc": "^0.27.9",
    "typescript": "~5.8",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.7"
  }
}
